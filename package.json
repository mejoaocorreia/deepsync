{
  "name": "deepsync-workspace",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "publint": "node scripts/publint.mjs",
    "pack:all": "node scripts/pack-all.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "release:check": "pnpm run check && pnpm run publint && pnpm run pack:all && pnpm run pack:smoke"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "oxlint": "1.76.0",
    "publint": "^0.3.24",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
