{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepsync.dev/schemas/dsh-health-result-v1.json",
  "title": "DeepSync DSH health result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocol", "pluginId", "pluginVersion", "targetInstanceId", "activationAttemptId", "status", "observedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocol": { "const": "deepsync.health/v1" },
    "pluginId": { "type": "string", "minLength": 1 },
    "pluginVersion": { "type": "string", "minLength": 1 },
    "targetInstanceId": { "type": "string", "minLength": 1 },
    "activationAttemptId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["healthy", "unhealthy"] },
    "observedAt": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "data": {}
  }
}
